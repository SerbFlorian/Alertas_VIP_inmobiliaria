# ==============================================
# BRIGHT DATA (Proxy / Web Unlocker)
# ==============================================
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker_vip
BRIGHTDATA_COUNTRY=es
BRIGHTDATA_ENABLED=true

# ==============================================
# TELEGRAM
# ==============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHANNEL_ID=
TELEGRAM_ADMIN_ID=

CLEANUP_DIAS_TELEGRAM=7
CLEANUP_DIAS_BD=14

# ==============================================
# STRIPE (solo servicio app via env_file)
# ==============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK=
STRIPE_PAYMENT_LINK_TIER2=
STRIPE_PAYMENT_LINK_TIER3=
STRIPE_BILLING_PORTAL_URL=

# ==============================================
# OPENAI (Asesor /asesor) — solo app
# ==============================================
OPENAI_API_KEY=
AI_VIP_DAILY_MAX=20
AI_VIP_WEEKLY_MAX=140
AI_FREE_MAX=3
# VIP: 1 alternativa/día por enlace caído; 3 recuperaciones/día con ficha+link
AI_BROKEN_LINK_DAILY_MAX=1
AI_AD_RECOVERY_DAILY_MAX=3
# Tope duro del asesor (OpenAI + búsqueda). Default 120000 = 2 min.
AI_TIMEOUT_MS=120000

# ==============================================
# CLOUDFLARE R2 — solo app
# ==============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=
BACKUP_RETENTION_DAYS=7

# ==============================================
# POSTGRES + REDIS (solo .env)
# ==============================================
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
DATABASE_URL="postgresql://alertas_user:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/alertas_vip?schema=public"
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@127.0.0.1:6379

# ==============================================
# SERVIDOR / ROLES
# ==============================================
NPM_NETWORK=nginx-proxy_default
# Compose: APP_ROLE / WORKER_MODE = app | scraper
# Local monolitico: all
# APP_ROLE=all
# WORKER_MODE=all
DIGEST_LOCK_TTL_MS=600000
PRIVACY_PURGE_HOURS=48
DATA_PURGE_HOURS=48

# ==============================================
# SCRAPING + DIGESTS + CHOLLO
# ==============================================
SCRAPER_PAGES=1
SCRAPER_CONCURRENCY=3
REQUEST_DELAY_MS=2000
MAX_RETRIES=1
DIGEST_WARMUP_MIN_MINUTES=5
DIGEST_WARMUP_MAX_MINUTES=15
# Máx. 1 envío rápido (5–15 min tras Aplicar) cada N horas. Aplicar filtros no tiene límite.
DIGEST_WARMUP_QUOTA_HOURS=24
# Cadencia seed / fallback (VIP nuevos); el intervalo real lo fija /horario (1–4 h)
NOTIFIER_INTERVAL_MINUTES=120
# NOTIF_INTERVAL_HOURS=2
# Cada cuántos minutos el cron mira quiénes están "due"
NOTIFIER_TICK_MINUTES=5
# Hard floor sistema (Europe/Madrid). /horario no puede salir de aquí.
NOTIF_HARD_START_HOUR=7
NOTIF_HARD_END_HOUR=23
# Defaults /horario para VIP nuevos
NOTIF_WINDOW_START_HOUR=8
NOTIF_WINDOW_END_HOUR=21
DIGEST_MAX_LISTINGS=3
# Prioridad “nuevo” dentro del digest (van primero)
DIGEST_LOOKBACK_DAYS=3
# Pool total elegible (nuevo + viejo no enviado). Default = CLEANUP_DIAS_BD
DIGEST_POOL_DAYS=14
DIGEST_SOLO_CHOLLOS=false
NOTIF_SEND_DELAY_MS=150
CHOLLO_MEDIANA_DAYS=14
CHOLLO_MIN_SAMPLES=5
CHOLLO_MIN_PCT=5
DEEP_SCRAPE_MAX_PER_PAGE=2
DEEP_SCRAPE_USE_BD=false

# ==============================================
# ENRICH ZONAS (Nominatim / OSM — 0€)
# ==============================================
# Lotes cada 2h en app. Manual: npm run enrich:zonas
ENRICH_ZONAS_ENABLED=true
ENRICH_ZONAS_BATCH=150
ENRICH_ZONAS_DELAY_MS=1100
ENRICH_ZONAS_REFRESH_STATS=true
# ENRICH_ZONAS_LOOP=true
# NOMINATIM_USER_AGENT=AlertasVIP/1.0 (ops@tudominio)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
